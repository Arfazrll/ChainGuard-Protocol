		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.7",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"phoenix": "1.8.16"
	}
}
